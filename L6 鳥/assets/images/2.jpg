<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 450" width="100%" height="100%">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#f1f5f9"/>
      <stop offset="100%" stop-color="#ffffff"/>
    </linearGradient>
    <filter id="shadow" x="-10%" y="-10%" width="120%" height="120%">
      <feDropShadow dx="0" dy="8" stdDeviation="12" flood-color="rgba(0,0,0,0.08)"/>
    </filter>
  </defs>
  <rect width="600" height="450" fill="url(#bg)"/>
  <rect x="25" y="25" width="550" height="400" rx="20" fill="#ffffff" stroke="#64748b" stroke-width="4" filter="url(#shadow)"/>
  <circle cx="300" cy="180" r="95" fill="#f1f5f9" stroke="#64748b" stroke-width="3"/>
  <text x="300" y="220" font-size="90" text-anchor="middle" font-family="'Segoe UI Emoji', 'Apple Color Emoji', sans-serif">🪤</text>
  <text x="300" y="325" font-size="38" font-weight="bold" fill="#0f172a" text-anchor="middle" font-family="'DFKai-SB', '標楷體', serif">第二段：失去自由之苦</text>
  <text x="300" y="375" font-size="20" fill="#64748b" text-anchor="middle" font-family="'Noto Sans TC', sans-serif">反面著筆 ‧ 架上鷹與籠中鳥</text>
</svg>